<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FitXpress" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_mesh</item>
    </style>

    <style name="Theme.FitXpress.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.FitXpress</item>
    </style>

    <style name="Theme.FitXpress.ScanCamera" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@style/ScanCameraWindowAnimation</item>
    </style>

    <style name="ScanCameraWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/scan_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/scan_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/scan_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/scan_fade_out</item>
    </style>

</resources>
